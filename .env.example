# ─────────────────────────────────────────────────────────────
# Zanzi Logistics — environment variables
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Quote form — Web3Forms (https://web3forms.com)
# Get a key by entering the destination inbox at https://web3forms.com.
#
# NOTE: variables prefixed with PUBLIC_ are inlined into the client-side
# JavaScript at build time, so they ARE visible in the browser. The
# Web3Forms access key is meant to be public — abuse is mitigated by the
# honeypot field and the allowed-domains setting in your Web3Forms
# dashboard. Do NOT put truly secret values behind a PUBLIC_ prefix.
#
# If this is left unset, the quote form stays visible but tells the
# visitor to email quotes@ directly instead of silently failing.
PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# ── Server-only secrets (no PUBLIC_ prefix) ──
# Variables without PUBLIC_ are NOT exposed to the browser; they are only
# available in server-side code (Astro endpoints / SSR). Put real secrets
# here as the site grows, e.g.:
# RESEND_API_KEY=
