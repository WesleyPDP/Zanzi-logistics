---
import Base from '../layouts/Base.astro';
import Tab from '../components/Tab.astro';
import { capabilities, certifications, whyZanzi } from '../data/company';
---
<Base
  title="Zanzi Logistics · We Don’t Just Carry Freight. We Carry Responsibility."
  description="Your business has bigger things to focus on than logistics. Zanzi Logistics takes responsibility for the operational challenges between your business and its growth — linehaul, same-day express, cross-border, dedicated freight, project logistics, healthcare logistics and warehousing."
>

  <!-- ═══ Hero ═══ -->
  <header class="hero">
    <div class="swoosh" aria-hidden="true"></div>
    <div class="container hero-stack">
      <p class="label hero-eyebrow">Logistics partner &middot; Southern Africa</p>

      <h1 class="display">
        Your business has<br />bigger things to focus<br />on than <em>logistics.</em>
      </h1>

      <p class="hero-sub">
        The strongest businesses know what they’re great at. They also know when
        to trust the right partner. At Zanzi Logistics, we take responsibility
        for the operational challenges that stand between your business and its
        growth &mdash; so you can focus on what you do best.
      </p>

      <div class="hero-actions">
        <a href="/contact" class="btn btn-red"><span>Let’s Talk</span> <span class="arr">&rarr;</span></a>
        <a href="/services" class="btn btn-ghost"><span>Explore Our Capabilities</span></a>
      </div>
    </div>
  </header>

  <!-- ═══ Every shipment carries more than freight ═══ -->
  <section class="ink-section carries">
    <div class="swoosh" aria-hidden="true"></div>
    <div class="container">
      <div class="carries-grid rv">
        <h2 class="display">
          Every shipment carries<br />more than <em>freight.</em>
        </h2>
        <div class="carries-body">
          <p>
            It carries a customer promise, production schedule, deadline and
            reputation.
          </p>
          <p>
            That’s why we don’t see logistics as simply moving cargo from one
            place to another. We see it as carrying part of your business.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Quiet Ownership ═══ -->
  <section class="dim">
    <div class="container">
      <div class="quiet rv">
        <Tab label="The Zanzi principle" />
        <h2 class="display">Quiet <em>Ownership.</em></h2>
        <div class="quiet-lines">
          <p>Great partnerships don’t demand attention.</p>
          <p>They quietly remove pressure and solve problems before they become yours.</p>
          <p>They communicate before you have to ask, and they follow through.</p>
        </div>
        <p class="quiet-close">
          That’s what Quiet Ownership means. It’s how we build trust, and how we
          move business forward.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ Our Capabilities ═══ -->
  <section id="capabilities">
    <div class="container">
      <div class="sec-head rv">
        <Tab label="Our capabilities" />
        <h2 class="display">What we <em>take care of.</em></h2>
        <p class="sub">
          Whether your freight is travelling across town or across Southern
          Africa, every service is backed by the same commitment: dependable
          execution, proactive communication and genuine partnership.
        </p>
      </div>

      <div class="cap-grid rv-group">
        {capabilities.map((c) => (
          <a href={`/services#${c.slug}`} class="cap">
            <span class="cap-no">{c.no}</span>
            <h3>{c.name}</h3>
            <p class="cap-lead">{c.lead}</p>
            <p class="cap-short">{c.short}</p>
          </a>
        ))}
      </div>

      <div class="cap-cta rv">
        <a href="/services" class="btn btn-ink"><span>View All Capabilities</span> <span class="arr">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- ═══ Built on Proven Standards ═══ -->
  <section class="dim">
    <div class="container">
      <div class="sec-head rv">
        <Tab label="Built on proven standards" />
        <h2 class="display">Trust is built on <em>consistency.</em></h2>
        <p class="sub">
          Partnerships are built on trust. That’s why our operations are
          underpinned by internationally recognised management systems that
          ensure every shipment is handled with quality, care and
          accountability.
        </p>
      </div>

      <div class="iso-grid rv-group">
        {certifications.map((c) => (
          <div class="iso">
            <span class="iso-code">{c.code}</span>
            <h3>{c.name}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>

      <p class="iso-close rv">
        Because carrying responsibility means holding ourselves to the highest
        standards.
      </p>
    </div>
  </section>

  <!-- ═══ More Than a Logistics Provider ═══ -->
  <section>
    <div class="container">
      <div class="more rv">
        <h2 class="display">
          Anyone can move freight.<br />We build <em>partnerships.</em>
        </h2>
        <p class="more-body">
          We become an extension of your team, helping you navigate operational
          challenges with confidence, transparency and experience. Because the
          best logistics partner is the one you never have to chase &mdash;
          they’re already thinking ahead.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ Why Businesses Choose Zanzi ═══ -->
  <section class="ink-section">
    <div class="swoosh" aria-hidden="true"></div>
    <div class="container">
      <div class="sec-head rv">
        <Tab label="Why Zanzi" />
        <h2 class="display">Why businesses<br /><em>choose</em> Zanzi.</h2>
      </div>

      <div class="why-grid rv-group">
        {whyZanzi.map((w, i) => (
          <div class="why">
            <span class="cap-no">{String(i + 1).padStart(2, '0')}</span>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="drench">
    <div class="container rv-group">
      <h2 class="display cta-title">
        Ready for a logistics partner<br />that feels like part of <em>your team?</em>
      </h2>
      <p class="cta-sub">
        Let’s talk about how Zanzi Logistics can support your business with
        dependable logistics, proactive communication and partnerships built to
        last.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-ink"><span>Start the Conversation</span> <span class="arr">&rarr;</span></a>
        <a href="/about" class="btn btn-ghost-red"><span>About Zanzi</span></a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── Hero ── */
  .hero {
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3.5rem, 7vw, 5.5rem);
    position: relative;
    overflow: hidden;
  }
  .hero-eyebrow { color: var(--red-deep); }
  .hero h1 { margin-top: 1.4rem; }
  .hero-sub {
    margin-top: clamp(1.6rem, 3vw, 2.2rem);
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--slate);
    max-width: 60ch;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.4rem; }

  /* ── Every shipment carries ── */
  .carries { overflow: hidden; }
  .carries-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .carries-body p {
    font-size: 1.08rem;
    line-height: 1.85;
    color: var(--mist-on-ink);
  }
  .carries-body p + p { margin-top: 1.3rem; }
  @media (max-width: 880px) { .carries-grid { grid-template-columns: 1fr; } }

  /* ── Quiet Ownership ── */
  .quiet { max-width: 60ch; }
  .quiet-lines {
    margin-top: 1.8rem;
    border-left: 4px solid var(--red);
    padding-left: 1.5rem;
  }
  .quiet-lines p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--slate-strong);
  }
  .quiet-lines p + p { margin-top: 0.8rem; }
  .quiet-close {
    margin-top: 1.8rem;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--slate);
  }

  /* ── Capabilities ── */
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .cap {
    background: var(--paper);
    padding: clamp(1.5rem, 3vw, 2.1rem);
    display: flex;
    flex-direction: column;
    transition: background 0.18s;
  }
  .cap:hover { background: var(--paper-dim); }
  .cap-no { align-self: flex-start; margin-bottom: 1.2rem; }
  .cap h3 { margin-bottom: 0.5rem; }
  .cap-lead {
    font-weight: 500;
    color: var(--red-deep);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 0.8rem;
  }
  .cap-short { font-size: 0.93rem; line-height: 1.7; color: var(--slate); }
  .cap-cta { margin-top: clamp(2rem, 4vw, 2.8rem); }
  @media (max-width: 940px) { .cap-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .cap-grid { grid-template-columns: 1fr; } }

  /* ── ISO ── */
  .iso-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .iso {
    background: var(--paper);
    border-top: 4px solid var(--red);
    padding: clamp(1.5rem, 3vw, 2rem);
  }
  .iso-code {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    margin-bottom: 0.7rem;
  }
  .iso h3 { font-size: 1rem; margin-bottom: 0.7rem; color: var(--slate-strong); }
  .iso p { font-size: 0.92rem; line-height: 1.7; color: var(--slate); }
  .iso-close {
    margin-top: clamp(1.8rem, 3.5vw, 2.5rem);
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--slate-strong);
    max-width: 56ch;
  }
  @media (max-width: 900px) { .iso-grid { grid-template-columns: 1fr; } }

  /* ── More than a provider ── */
  .more { max-width: 68ch; }
  .more-body {
    margin-top: 1.6rem;
    font-size: 1.08rem;
    line-height: 1.85;
    color: var(--slate);
  }

  /* ── Why Zanzi ── */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 3.5vw, 3rem);
  }
  .why h3 { margin: 0.9rem 0 0.7rem; }
  .why p { font-size: 0.96rem; line-height: 1.8; color: var(--mist-on-ink); }
  @media (max-width: 880px) { .why-grid { grid-template-columns: 1fr; } }

  /* ── CTA ── */
  .cta-title { font-size: clamp(1.9rem, 4.4vw, 3.4rem); }
  .cta-sub {
    margin-top: 1.4rem;
    font-size: 1.06rem;
    line-height: 1.8;
    max-width: 56ch;
  }
  .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.2rem; }
</style>
