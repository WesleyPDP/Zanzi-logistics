---
import Base from '../layouts/Base.astro';
import SecMark from '../components/SecMark.astro';
import { divisions, equipment, quoteChecklist } from '../data/company';

// Divisions alternate paper / dim down the page.
const bands = ['', 'dim', ''];
const serviceCount = divisions.reduce((n, d) => n + d.services.length, 0);
---
<Base
  title="Services · Road Freight, Warehousing & Customs · Zanzi Logistics"
  description="Zanzi Logistics services: FTL and LTL road freight, containerised and abnormal haulage, 3PL warehousing, pick and pack, cross-docking, SADC cross-border freight, customs clearing and international forwarding."
>

  <header class="page-hero">
    <div class="container hero-stack">
      <div class="data-strip">
        <span class="data">{divisions.length} divisions &middot; {serviceCount} services</span>
        <span class="data">
          {divisions.map((d, i) => <>{i > 0 && ' · '}<strong>{d.code}</strong></>)}
        </span>
      </div>
      <h1 class="display">What we <em>move,</em><br />hold and clear.</h1>
      <p class="page-sub">
        Three divisions under one roof. If a job needs all three &mdash; cleared
        at the border, held in the warehouse, delivered on our own fleet &mdash;
        it stays on one waybill and one invoice.
      </p>
    </div>
  </header>

  <div class="hazard" aria-hidden="true"></div>

  <!-- Division index -->
  <section class="tight">
    <div class="container">
      <nav class="div-index rv-group" aria-label="Divisions">
        {divisions.map((d) => (
          <a href={`#${d.slug}`} class="dx">
            <span class="plate">{d.code}</span>
            <span class="dx-body">
              <span class="dx-name">{d.name}</span>
              <span class="data">{d.short}</span>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ═══ Divisions ═══ -->
  {divisions.map((d, i) => (
    <section id={d.slug} class={bands[i]}>
      <div class="container">
        <div class="sec-head rv">
          <SecMark label={`Division ${d.code}`} />
          <h2 class="display">{d.name}</h2>
          <p class="sub">{d.blurb}</p>
        </div>

        <div class="table-scroll rv">
          <table class="manifest">
            <thead>
              <tr>
                <th scope="col">Ref</th>
                <th scope="col">Service</th>
                <th scope="col">What it covers</th>
              </tr>
            </thead>
            <tbody>
              {d.services.map((s) => (
                <tr>
                  <th scope="row" class="m-code">{s.ref}</th>
                  <td class="svc-name">{s.name}</td>
                  <td>{s.desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))}

  <!-- ═══ Equipment (black) ═══ -->
  <section class="ink-section">
    <div class="container">
      <div class="sec-head rv">
        <SecMark label="Equipment" />
        <h2 class="display">The right vehicle,<br />not the <em>nearest</em> one.</h2>
        <p class="sub">
          The vehicle is chosen from the mass, the dimensions and what is at
          each end. Quoting a superlink for a two-pallet job is how you end up
          paying for air.
        </p>
      </div>

      <div class="table-scroll rv">
        <table class="manifest">
          <thead>
            <tr>
              <th scope="col">Vehicle</th>
              <th scope="col">Payload</th>
              <th scope="col">Deck</th>
              <th scope="col">Typical use</th>
            </tr>
          </thead>
          <tbody>
            {equipment.map((e) => (
              <tr>
                <th scope="row">{e.type}</th>
                <td class="m-num">{e.payload}</td>
                <td class="m-num">{e.deck}</td>
                <td>{e.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══ Quote checklist ═══ -->
  <section class="dim">
    <div class="container">
      <div class="sec-head rv">
        <SecMark label="Before you ask" />
        <h2 class="display">Six answers and<br />you have a <em>rate.</em></h2>
        <p class="sub">
          Send these with your enquiry and the quote comes back same-day.
          Send what you have and we will ask for the rest &mdash; but the more
          of this you can give us, the firmer the number.
        </p>
      </div>

      <ol class="check-grid rv-group">
        {quoteChecklist.map((q) => (
          <li class="check">
            <span class="data check-ref">{q.ref}</span>
            <h3>{q.item}</h3>
            <p>{q.why}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="drench">
    <div class="container rv-group">
      <div class="data-strip cta-strip">
        <span class="data">Same-day quotes</span>
        <span class="data">Written rates</span>
        <span class="data">Ad-hoc or contract</span>
      </div>
      <h2 class="display cta-title">Send us the <em>load.</em></h2>
      <p class="cta-sub">
        One job or a full contract &mdash; both start the same way, with the
        details of what needs to move.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-ink">Get a quote <span class="arr">&rarr;</span></a>
        <a href="/network" class="btn btn-ghost-red">See the network</a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── Division index ── */
  .div-index {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .dx {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    padding: 1.1rem 1.25rem;
    transition: border-color 0.18s;
  }
  .dx:hover { border-color: var(--red); }
  .dx .plate { flex-shrink: 0; }
  .dx-body { display: flex; flex-direction: column; gap: 0.35rem; }
  .dx-name { font-weight: 600; font-size: 1rem; line-height: 1.3; }
  @media (max-width: 900px) { .div-index { grid-template-columns: 1fr; } }

  /* ── Service tables ── */
  .svc-name { color: var(--ink) !important; font-weight: 500; white-space: nowrap; }
  @media (max-width: 700px) { .svc-name { white-space: normal; } }

  /* ── Quote checklist ── */
  .check-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .check { border-top: 2px solid var(--red); padding-top: 1.2rem; }
  .check-ref { color: var(--red-deep); font-weight: 600; }
  .check h3 { margin: 0.5rem 0 0.6rem; font-size: 1.1rem; }
  .check p { font-size: 0.92rem; line-height: 1.7; color: var(--steel); }
  @media (max-width: 940px) { .check-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .check-grid { grid-template-columns: 1fr; } }

  /* ── CTA ── */
  .cta-title {
    margin-top: clamp(1.6rem, 3.5vw, 2.4rem);
    font-size: clamp(2.5rem, 7vw, 5.2rem);
  }
  .cta-sub { margin-top: 1.2rem; font-size: 1.04rem; line-height: 1.75; max-width: 48ch; }
  .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.2rem; }
</style>
