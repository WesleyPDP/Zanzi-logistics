---
import Base from '../layouts/Base.astro';
import Tab from '../components/Tab.astro';
import { capabilities, certifications, vehicles } from '../data/company';
---
<Base
  title="Capabilities · Zanzi Logistics"
  description="Linehaul, same-day express, cross-border, dedicated freight, project logistics, healthcare logistics and warehousing. Every Zanzi Logistics service is backed by dependable execution, proactive communication and genuine partnership."
>

  <header class="page-hero">
    <div class="swoosh" aria-hidden="true"></div>
    <div class="container hero-stack">
      <p class="label">Our capabilities</p>
      <h1 class="display">What we <em>take care of.</em></h1>
      <p class="page-sub">
        Whether your freight is travelling across town or across Southern
        Africa, every service is backed by the same commitment: dependable
        execution, proactive communication and genuine partnership.
      </p>
    </div>
  </header>

  <!-- ═══ Index ═══ -->
  <section class="tight dim">
    <div class="container">
      <nav class="cap-index rv-group" aria-label="Capabilities">
        {capabilities.map((c) => (
          <a href={`#${c.slug}`} class="ci">
            <span class="cap-no">{c.no}</span>
            <span class="ci-name">{c.name}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ═══ Capabilities in full ═══ -->
  <section class="cap-detail">
    <div class="container">
      <div class="cap-rows">
        {capabilities.map((c) => (
          <article id={c.slug} class="cr rv">
            <div class="cr-head">
              <span class="cap-no">{c.no}</span>
              <h2 class="display cr-name">{c.name}</h2>
            </div>
            <div class="cr-body">
              <p class="cr-lead">{c.lead}</p>
              <p class="cr-copy">{c.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Vehicles ═══ -->
  <section class="dim" id="vehicles">
    <div class="container">
      <div class="sec-head rv">
        <Tab label="Vehicles" />
        <h2 class="display">The right vehicle<br />for the <em>load.</em></h2>
        <p class="sub">
          From a single pallet on a one-tonner to a full superlink, the vehicle
          is matched to the freight &mdash; its mass, its dimensions and what is
          waiting at each end. Tail-lift options are available where there is no
          loading dock or forklift on site.
        </p>
      </div>

      <ul class="veh-grid rv-group">
        {vehicles.map((v) => (
          <li class="veh">
            <span class="veh-size">{v.size}</span>
            {v.feature && <span class="veh-feature label">{v.feature}</span>}
          </li>
        ))}
      </ul>

      <p class="veh-note rv">
        Not sure which you need? Tell us the mass, the dimensions and whether
        there is a forklift at each end, and we will choose it for you.
        <a class="link" href="/contact">Start there</a>.
      </p>
    </div>
  </section>

  <!-- ═══ Certified for Confidence ═══ -->
  <section class="ink-section" id="certifications">
    <div class="swoosh" aria-hidden="true"></div>
    <div class="container">
      <div class="sec-head rv">
        <Tab label="Certified for confidence" />
        <h2 class="display">Backed by recognised<br /><em>standards.</em></h2>
        <p class="sub">
          Our commitment to quality, safety and operational excellence is backed
          by internationally recognised management standards.
        </p>
      </div>

      <div class="iso-list rv-group">
        {certifications.map((c) => (
          <div class="iso-row">
            <span class="iso-code">{c.code}</span>
            <div>
              <h3>{c.name}</h3>
              <p>{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="drench">
    <div class="container rv-group">
      <h2 class="display cta-title">
        Not sure which one<br />you <em>need?</em>
      </h2>
      <p class="cta-sub">
        Tell us what you’re trying to achieve or the challenge you’re facing,
        and we’ll start building the right solution together.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-ink"><span>Start the Conversation</span> <span class="arr">&rarr;</span></a>
        <a href="/network" class="btn btn-ghost-red"><span>Where We Move</span></a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── Index ── */
  /* box-shadow rings, not a container background: 7 capabilities never
     fill a 4- or 2-column grid, and the container would show through as
     empty grey cells in the last row */
  .cap-index {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
  }
  .ci {
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--rule);
    padding: 1.1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: background 0.18s;
  }
  .ci:hover { background: var(--paper-deep); }
  .ci .cap-no { font-size: 0.95rem; }
  .ci-name { font-weight: 600; font-size: 0.95rem; line-height: 1.3; }
  @media (max-width: 940px) { .cap-index { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .cap-index { grid-template-columns: 1fr; } }

  /* ── Capability rows ── */
  .cap-rows { display: flex; flex-direction: column; }
  .cr {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: calc(var(--nav-h) + 20px);
  }
  .cr:first-child { padding-top: 0; }
  .cr:last-child { border-bottom: none; }
  .cr-head { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .cr-head .cap-no { font-size: 1.4rem; }
  .cr-name { font-size: clamp(1.6rem, 3.2vw, 2.4rem); }
  .cr-lead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--red-deep);
    margin-bottom: 1.1rem;
  }
  .cr-copy { font-size: 1.02rem; line-height: 1.85; color: var(--slate); }
  @media (max-width: 820px) {
    .cr { grid-template-columns: 1fr; gap: 1.25rem; }
    .cr-head { flex-direction: row; align-items: baseline; gap: 1rem; }
  }

  /* ── Vehicles ──
     box-shadow rings rather than a container background: ten vehicles never
     fill a 5- or 3-column grid, and the container would show through as
     empty grey cells in the last row */
  .veh-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
  }
  .veh {
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--rule);
    padding: 1.4rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 3px solid var(--red);
  }
  .veh-size {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .veh-feature { color: var(--red-deep); letter-spacing: 0.12em; }
  .veh-note {
    margin-top: clamp(1.6rem, 3vw, 2.2rem);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--slate);
    max-width: 64ch;
  }
  @media (max-width: 1040px) { .veh-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 820px) { .veh-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .veh-grid { grid-template-columns: 1fr 1fr; } }

  /* ── ISO ── */
  .iso-list { display: flex; flex-direction: column; }
  .iso-row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1rem 2.5rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--rule-on-ink);
  }
  .iso-row:last-child { border-bottom: none; }
  .iso-code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    color: var(--red-bright);
  }
  .iso-row h3 { margin-bottom: 0.5rem; }
  .iso-row p { font-size: 0.98rem; line-height: 1.8; color: var(--mist-on-ink); }
  @media (max-width: 700px) { .iso-row { grid-template-columns: 1fr; gap: 0.6rem; } }

  /* ── CTA ── */
  .cta-title { font-size: clamp(1.9rem, 4.4vw, 3.4rem); }
  .cta-sub { margin-top: 1.4rem; font-size: 1.06rem; line-height: 1.8; max-width: 54ch; }
  .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.2rem; }
</style>
