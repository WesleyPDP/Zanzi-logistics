---
import Base from '../layouts/Base.astro';
import Tab from '../components/Tab.astro';
import { contact, capabilities, expectations, vehicles } from '../data/company';
---
<Base
  title="Contact · Zanzi Logistics"
  description="The right logistics partner changes more than your supply chain. Tell us about your business and we’ll explore how Zanzi Logistics can help. Johannesburg, South Africa."
>

  <header class="page-hero">
    <div class="swoosh" aria-hidden="true"></div>
    <div class="container hero-stack">
      <p class="label">Contact</p>
      <h1 class="display">
        The right partner changes<br />more than your <em>supply chain.</em>
      </h1>
      <p class="page-sub">
        It changes how confidently you run your business. Whether you’re looking
        for ongoing logistics support, cross-border expertise or help with a
        specific operational challenge, we’d love to understand your business
        and explore how we can help.
      </p>
    </div>
  </header>

  <section class="tight form-section">
    <div class="container contact-grid">

      <!-- ═══ The form ═══ -->
      <div class="rv">
        <div class="form-intro">
          <Tab label="Tell us about your business" />
          <p>
            Every business operates differently. That’s why we don’t believe in
            one-size-fits-all logistics. Tell us a little about your business,
            what you’re trying to achieve or the challenge you’re facing, and
            we’ll start building the right solution together.
          </p>
        </div>

        <form id="contact-form" class="intake">
          <input type="checkbox" name="botcheck" id="botcheck" class="hp-field" tabindex="-1" autocomplete="off" />

          <p class="form-legend">About you</p>

          <div class="form-row">
            <div class="field">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" placeholder="Your name" required maxlength="80" autocomplete="name" />
            </div>
            <div class="field">
              <label for="company">Company Name <span class="opt">&middot; optional</span></label>
              <input type="text" id="company" name="company" placeholder="Your business" maxlength="120" autocomplete="organization" />
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="you@company.co.za" required maxlength="254" autocomplete="email" />
            </div>
            <div class="field">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="071 234 5678" required maxlength="24" autocomplete="tel" />
            </div>
          </div>

          <p class="form-legend">
            Your freight
            <span class="legend-note">
              All optional &mdash; but the more you can tell us, the faster we
              can come back with something useful.
            </span>
          </p>

          <div class="form-row">
            <div class="field">
              <label for="service">Service Required <span class="opt">&middot; optional</span></label>
              <select id="service" name="service">
                <option value="">Select a service&hellip;</option>
                {capabilities.map((c) => <option>{c.name}</option>)}
                <option>Not sure yet &mdash; please advise</option>
              </select>
            </div>
            <div class="field">
              <label for="vehicle">Vehicle Required <span class="opt">&middot; optional</span></label>
              <select id="vehicle" name="vehicle">
                <option value="">Select a vehicle&hellip;</option>
                {vehicles.map((v) => <option>{v.name}</option>)}
                <option>Not sure &mdash; please advise</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="origin">Collection From <span class="opt">&middot; optional</span></label>
              <input type="text" id="origin" name="origin" placeholder="Town or suburb, province" maxlength="120" />
            </div>
            <div class="field">
              <label for="destination">Delivery To <span class="opt">&middot; optional</span></label>
              <input type="text" id="destination" name="destination" placeholder="Town or suburb, province or country" maxlength="120" />
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="cargo">What Is The Freight? <span class="opt">&middot; optional</span></label>
              <input type="text" id="cargo" name="cargo" placeholder="e.g. palletised dry goods" maxlength="140" />
            </div>
            <div class="field">
              <label for="weight">Mass / Pallets <span class="opt">&middot; optional</span></label>
              <input type="text" id="weight" name="weight" placeholder="e.g. 3 200 kg, 6 pallets" maxlength="80" />
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="ready">Ready For Collection <span class="opt">&middot; optional</span></label>
              <input type="date" id="ready" name="ready" />
            </div>
            <div class="field">
              <label for="frequency">How Often? <span class="opt">&middot; optional</span></label>
              <select id="frequency" name="frequency">
                <option value="">Select&hellip;</option>
                <option>One-off shipment</option>
                <option>A few times a month</option>
                <option>Weekly</option>
                <option>Daily / ongoing contract</option>
              </select>
            </div>
          </div>

          <p class="form-legend">Anything else</p>

          <div class="field">
            <label for="message">Tell Us About Your Requirements</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              maxlength="2000"
              required
              placeholder="What you’re trying to achieve, or the challenge you’re facing."
            ></textarea>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>I consent to Zanzi Logistics processing these details in order to respond to my enquiry.</span>
          </label>

          <button id="submit-btn" type="submit" class="btn btn-red form-btn">
            <span>Submit</span> <span class="arr">&rarr;</span>
          </button>

          <p id="form-error" class="form-error" hidden></p>
        </form>

        <div id="success-msg" class="success" hidden>
          <h2 class="display success-title">Thank you.</h2>
          <p class="success-body">
            Your message is with us. We’ll come back to you to understand your
            business and explore how we can help.
          </p>
          <p class="success-alt">
            Need us sooner? Call
            <a class="link" href={contact.phoneHref}>{contact.phone}</a>
          </p>
        </div>
      </div>

      <!-- ═══ Prefer to talk ═══ -->
      <aside class="contact-side rv">
        <div class="talk-card">
          <h2 class="talk-title display">Prefer to talk?</h2>
          <p class="talk-body">
            Sometimes the best conversations happen over the phone. Whether you
            have a quick question or want to discuss your logistics requirements
            in more detail, our team is ready to help.
          </p>

          <dl class="talk-list">
            <div>
              <dt class="label">Phone</dt>
              <dd>
                <a href={contact.phoneHref}>{contact.phone}</a>
                <a href={contact.phoneAltHref}>{contact.phoneAlt}</a>
              </dd>
            </div>
            <div>
              <dt class="label">Email</dt>
              <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
            </div>
            <div>
              <dt class="label">Office</dt>
              <dd><span class="talk-plain">{contact.office}</span></dd>
            </div>
            <div>
              <dt class="label">Business Hours</dt>
              <dd><span class="talk-plain">{contact.hours}</span></dd>
            </div>
          </dl>
        </div>
      </aside>

    </div>
  </section>

  <!-- ═══ What You Can Expect ═══ -->
  <section class="dim">
    <div class="container">
      <div class="sec-head rv">
        <Tab label="What you can expect" />
        <h2 class="display">How this <em>starts.</em></h2>
      </div>

      <div class="exp-grid rv-group">
        {expectations.map((e, i) => (
          <div class="exp">
            <span class="cap-no">{String(i + 1).padStart(2, '0')}</span>
            <h3>{e.title}</h3>
            <p>{e.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="drench">
    <div class="container rv-group">
      <h2 class="display cta-title">
        More than a conversation.<br />The start of a <em>partnership.</em>
      </h2>
      <p class="cta-sub">
        At Zanzi Logistics, we believe the best partnerships are built on trust,
        communication and shared responsibility. Every relationship starts with
        a conversation. We look forward to having ours.
      </p>
      <div class="cta-actions">
        <a href={contact.phoneHref} class="btn btn-ink"><span>Call {contact.phone}</span></a>
        <a href={`mailto:${contact.email}`} class="btn btn-ghost-red"><span>Email Us</span></a>
      </div>
    </div>
  </section>

</Base>

<style>
  .form-section { padding-bottom: clamp(3.5rem, 7vw, 5.5rem); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  .contact-grid > * { min-width: 0; }
  @media (max-width: 940px) { .contact-grid { grid-template-columns: 1fr; } }

  .form-intro { margin-bottom: 2.2rem; }
  .form-intro p {
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--slate);
    max-width: 58ch;
  }

  /* Group headings. Only name, email, phone and the requirements box are
     required — everything under "Your freight" just speeds up the reply. */
  .form-legend {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    padding-bottom: 0.7rem;
    margin-bottom: 1.4rem;
    border-bottom: 2px solid var(--red);
    /* it is a <p>, so the global 68ch measure would stop the rule short */
    max-width: none;
  }
  .form-legend:not(:first-of-type) { margin-top: 1rem; }
  .legend-note {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.6;
    color: var(--slate);
    max-width: 52ch;
  }

  /* honeypot: off-screen, never reachable by keyboard */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.7rem;
    margin: 0.4rem 0 1.6rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--slate);
  }
  .consent input {
    width: 18px;
    height: 18px;
    margin-top: 0.15rem;
    accent-color: var(--red);
    cursor: pointer;
  }

  .form-btn { justify-content: center; min-width: 14rem; }
  .form-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .form-error {
    margin-top: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--red-deep);
    font-weight: 500;
    border-left: 4px solid var(--red);
    padding-left: 1rem;
  }

  .success { border-left: 4px solid var(--red); padding-left: 1.5rem; }
  /* author display would otherwise defeat the `hidden` attribute */
  .success[hidden] { display: none; }
  .success-title { font-size: clamp(1.8rem, 3.6vw, 2.6rem); }
  .success-body {
    margin-top: 1rem;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--slate);
    max-width: 46ch;
  }
  .success-alt { margin-top: 1.2rem; font-size: 0.95rem; color: var(--slate); }

  /* ── Prefer to talk ── */
  .contact-side {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }
  @media (max-width: 940px) { .contact-side { position: static; } }

  .talk-card {
    background: var(--ink);
    color: var(--paper-on-ink);
    padding: clamp(1.6rem, 3.5vw, 2.25rem);
    border-top: 5px solid var(--red);
  }
  .talk-title { font-size: clamp(1.5rem, 3vw, 1.9rem); }
  .talk-body {
    margin-top: 1rem;
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--mist-on-ink);
  }
  .talk-list {
    margin-top: 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }
  .talk-list dt { color: var(--red-bright); margin-bottom: 0.45rem; }
  .talk-list dd { display: flex; flex-direction: column; gap: 0.3rem; }
  .talk-list a, .talk-plain {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--paper-on-ink);
    word-break: break-word;
  }
  .talk-list a { transition: color 0.15s; }
  .talk-list a:hover { color: var(--red-bright); }
  .talk-plain { font-weight: 400; color: var(--mist-on-ink); }

  /* ── Expectations ── */
  .exp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  .exp h3 { margin: 0.9rem 0 0.6rem; }
  .exp p { font-size: 0.96rem; line-height: 1.8; color: var(--slate); }
  @media (max-width: 880px) { .exp-grid { grid-template-columns: 1fr; } }

  /* ── CTA ── */
  .cta-title { font-size: clamp(1.9rem, 4.4vw, 3.4rem); }
  .cta-sub { margin-top: 1.4rem; font-size: 1.06rem; line-height: 1.8; max-width: 58ch; }
  .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.2rem; }
</style>

<script>
  import { contact } from '../data/company';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const success = document.getElementById('success-msg') as HTMLElement;
  const errorMsg = document.getElementById('form-error') as HTMLElement;

  // Web3Forms access key. Public by design (it lands in the client bundle
  // either way) — abuse is mitigated by the honeypot and the allowed-domains
  // setting in the Web3Forms dashboard. Set PUBLIC_WEB3FORMS_ACCESS_KEY in
  // the Cloudflare Pages build environment; see README.
  const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
  const FALLBACK_EMAIL = contact.email;

  let sending = false;

  const fail = (msg: string) => {
    errorMsg.textContent = msg;
    errorMsg.hidden = false;
    sending = false;
    btn.disabled = false;
    btn.innerHTML = '<span>Submit</span> <span class="arr">→</span>';
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (sending) return;

    // honeypot
    if ((document.getElementById('botcheck') as HTMLInputElement).checked) return;

    sending = true;
    btn.disabled = true;
    btn.textContent = 'Sending…';
    errorMsg.hidden = true;

    // The form has not been connected to an inbox yet — say so plainly
    // rather than silently dropping an enquiry on the floor.
    if (!ACCESS_KEY) {
      fail(
        `This form is not connected to an inbox yet. Please email your enquiry to ${FALLBACK_EMAIL} and it will be picked up.`
      );
      return;
    }

    const fields = new FormData(form);
    fields.append('access_key', ACCESS_KEY);
    fields.append('subject', 'New enquiry · Zanzi Logistics website');
    fields.append('from_name', 'Zanzi Logistics Website');

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: fields,
      });
      const data = await res.json().catch(() => ({}) as any);
      if (res.ok && data.success) {
        form.hidden = true;
        (document.querySelector('.form-intro') as HTMLElement)?.setAttribute('hidden', '');
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      // Surface the real reason the mail service gave.
      fail(
        data.message
          ? `Could not send: ${data.message}. Please try again, or email ${FALLBACK_EMAIL}.`
          : `Something went wrong. Please try again, or email ${FALLBACK_EMAIL}.`
      );
    } catch {
      // fetch threw: usually no connection, or a content blocker / VPN on the
      // device blocked the request to the mail service.
      fail(
        `Could not reach the mail service. Check your connection and any ad blocker or VPN, then try again — or email ${FALLBACK_EMAIL}.`
      );
    }
  });
</script>
