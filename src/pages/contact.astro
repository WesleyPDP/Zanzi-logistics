---
import Base from '../layouts/Base.astro';
import { contact, hubs, quoteChecklist } from '../data/company';
---
<Base
  title="Get a Quote · Zanzi Logistics"
  description="Request a freight quote from Zanzi Logistics. Send the collection and delivery points, what the freight is and when it is ready, and we come back with a written rate and a collection window."
  ref="ZL-05"
  refName="Enquiry"
>

  <header class="page-hero">
    <div class="container hero-stack">
      <div class="data-strip">
        <span class="data"><strong>Ref ZL-05</strong> &middot; Enquiry</span>
        <span class="data">Same-day quotes &middot; no booking fee</span>
      </div>
      <h1 class="display">Get a <em>quote.</em></h1>
      <p class="page-sub">
        Tell us what is moving, where from and where to. If we are the right
        carrier for it you get a written rate and a collection window. If we are
        not, we will say so.
      </p>
    </div>
  </header>

  <div class="hazard" aria-hidden="true"></div>

  <section class="tight enquiry-wrap">
    <div class="container contact-grid">

      <!-- ═══ The form ═══ -->
      <div class="intake rv">
        <header class="intake-head">
          <span class="data"><strong>Freight enquiry</strong></span>
          <span class="data">Form ZL/ENQ/01</span>
        </header>

        <form id="quote-form" class="intake-body">
          <input type="checkbox" name="botcheck" id="botcheck" class="hp-field" tabindex="-1" autocomplete="off" />

          <p class="data form-legend">Section 1 &middot; Who you are</p>

          <div class="form-row">
            <div class="field">
              <label for="name">Your name</label>
              <input type="text" id="name" name="name" placeholder="Full name" required maxlength="80" autocomplete="name" />
            </div>
            <div class="field">
              <label for="company">Company <span class="opt">&middot; optional</span></label>
              <input type="text" id="company" name="company" placeholder="Business name" maxlength="120" autocomplete="organization" />
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="you@company.co.za" required maxlength="254" autocomplete="email" />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" placeholder="071 234 5678" required maxlength="24" autocomplete="tel" />
            </div>
          </div>

          <p class="data form-legend">Section 2 &middot; The freight</p>

          <div class="field">
            <label for="service">What do you need?</label>
            <select id="service" name="service" required>
              <option value="">Select a service&hellip;</option>
              <option>Road freight &mdash; full load (FTL)</option>
              <option>Road freight &mdash; part load / groupage (LTL)</option>
              <option>Containerised or abnormal haulage</option>
              <option>Warehousing &amp; distribution (3PL)</option>
              <option>Cross-border into SADC</option>
              <option>Customs clearing only</option>
              <option>International sea or air forwarding</option>
              <option>Dedicated contract fleet</option>
              <option>Not sure &mdash; please advise</option>
            </select>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="origin">Collection from</label>
              <input type="text" id="origin" name="origin" placeholder="Town or suburb, province" required maxlength="120" />
            </div>
            <div class="field">
              <label for="destination">Delivery to</label>
              <input type="text" id="destination" name="destination" placeholder="Town or suburb, province or country" required maxlength="120" />
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="cargo">What is the freight? <span class="opt">&middot; optional</span></label>
              <input type="text" id="cargo" name="cargo" placeholder="e.g. palletised dry goods" maxlength="140" />
            </div>
            <div class="field">
              <label for="weight">Mass / pallets <span class="opt">&middot; optional</span></label>
              <input type="text" id="weight" name="weight" placeholder="e.g. 3 200 kg, 6 pallets" maxlength="80" />
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="ready">Ready for collection <span class="opt">&middot; optional</span></label>
              <input type="date" id="ready" name="ready" />
            </div>
            <div class="field">
              <label for="frequency">How often? <span class="opt">&middot; optional</span></label>
              <select id="frequency" name="frequency">
                <option value="">Optional</option>
                <option>One-off consignment</option>
                <option>A few times a month</option>
                <option>Weekly</option>
                <option>Daily / ongoing contract</option>
              </select>
            </div>
          </div>

          <p class="data form-legend">Section 3 &middot; Anything else</p>

          <div class="field">
            <label for="message">Notes <span class="opt">&middot; optional</span></label>
            <textarea id="message" name="message" rows="5" maxlength="2000" placeholder="Loading and offloading arrangements, deadlines, special handling, hazardous or high-value cargo, or anything that would change the rate."></textarea>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>I consent to Zanzi Logistics processing these details in order to respond to my enquiry.</span>
          </label>

          <button id="submit-btn" type="submit" class="btn btn-red form-btn">
            Send enquiry <span class="arr">&rarr;</span>
          </button>

          <p id="form-error" class="form-error" hidden></p>
        </form>

        <div id="success-msg" class="success" hidden>
          <span class="plate plate-fill">Received</span>
          <p class="success-title display">Enquiry logged.</p>
          <p class="success-body">
            Thank you. A controller will come back to you with a written rate,
            or with the one question we need answered before we can price it.
          </p>
          <p class="data">
            Urgent? Call <a class="link" href={contact.phoneHref}>{contact.phone}</a>
          </p>
        </div>
      </div>

      <!-- ═══ Sidebar ═══ -->
      <aside class="contact-side rv">
        <div class="side-card side-card-red">
          <p class="data side-title">Speak to someone</p>
          <ul class="side-lines">
            <li>
              <span class="data">Switchboard</span>
              <a href={contact.phoneHref}>{contact.phone}</a>
            </li>
            <li>
              <span class="data">Operations &middot; 24/7</span>
              <a href={contact.opsPhoneHref}>{contact.opsPhone}</a>
            </li>
            <li>
              <span class="data">Quotes</span>
              <a href={`mailto:${contact.quotesEmail}`}>{contact.quotesEmail}</a>
            </li>
            <li>
              <span class="data">General</span>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
          </ul>
          <p class="side-hours data">{contact.hours}</p>
          <p class="side-hours data">{contact.opsHours}</p>
        </div>

        <div class="side-card">
          <p class="data side-title">Speeds up your quote</p>
          <ol class="side-check">
            {quoteChecklist.slice(0, 5).map((q) => (
              <li><span class="data">{q.ref}</span> {q.item}</li>
            ))}
          </ol>
        </div>

        <div class="side-card side-card-dim">
          <p class="data side-title">Depots</p>
          <ul class="side-hubs">
            {hubs.map((h) => (
              <li>
                <span class="hub-code data">{h.code}</span>
                <span>
                  <strong>{h.city}</strong>
                  <span class="data">{h.address}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </aside>

    </div>
  </section>

</Base>

<style>
  .enquiry-wrap { padding-bottom: clamp(4rem, 8vw, 6.5rem); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 940px) { .contact-grid { grid-template-columns: 1fr; } }

  /* ── The form sheet ── */
  .intake {
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
  }
  .intake-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.85rem clamp(1.4rem, 3vw, 2.25rem);
    background: var(--ink);
    border-bottom: 2px solid var(--red);
  }
  .intake-head .data { color: var(--mist-on-ink); }
  .intake-head .data strong { color: var(--paper-on-ink); }
  .intake-body, .success { padding: clamp(1.5rem, 3.5vw, 2.25rem); }

  .form-legend {
    color: var(--red-deep);
    font-weight: 600;
    padding-bottom: 0.6rem;
    margin-bottom: 1.3rem;
    border-bottom: 1px solid var(--rule);
  }
  .form-legend:not(:first-of-type) { margin-top: 0.6rem; }

  /* honeypot: off-screen, never reachable by keyboard */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.7rem;
    margin: 0.2rem 0 1.5rem;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--steel);
  }
  .consent input {
    width: 18px;
    height: 18px;
    margin-top: 0.12rem;
    accent-color: var(--red);
    cursor: pointer;
  }

  .form-btn { width: 100%; justify-content: center; }
  .form-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .form-error {
    margin-top: 1rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--red-deep);
    font-weight: 500;
    border-left: 3px solid var(--red);
    padding-left: 0.9rem;
  }

  .success { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; }
  /* author display would otherwise defeat the `hidden` attribute */
  .success[hidden] { display: none; }
  .success-title { font-size: clamp(1.6rem, 3.2vw, 2.2rem); }
  .success-body { color: var(--steel); line-height: 1.75; max-width: 46ch; }

  /* ── Sidebar ── */
  .contact-side {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  @media (max-width: 940px) { .contact-side { position: static; } }

  .side-card { border: 1px solid var(--rule-strong); padding: clamp(1.4rem, 3vw, 1.8rem); }
  .side-card-dim { background: var(--paper-dim); border-color: var(--rule); }
  .side-card-red {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper-on-ink);
  }
  .side-card-red .data { color: var(--mist-on-ink); }
  .side-title { color: var(--red-deep); font-weight: 600; margin-bottom: 1.2rem; }
  .side-card-red .side-title { color: var(--red-bright); }

  .side-lines { list-style: none; display: flex; flex-direction: column; gap: 1rem; }
  .side-lines li { display: flex; flex-direction: column; gap: 0.25rem; }
  .side-lines a {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--paper-on-ink);
    transition: color 0.15s;
    word-break: break-word;
  }
  .side-lines a:hover { color: var(--red-bright); }
  .side-hours {
    margin-top: 1.2rem;
    line-height: 1.6;
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .side-hours + .side-hours { margin-top: 0.5rem; }

  .side-check { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
  .side-check li {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink);
    display: grid;
    grid-template-columns: 1.8rem 1fr;
    gap: 0.4rem;
  }
  .side-check .data { color: var(--red-deep); font-weight: 600; }

  .side-hubs { list-style: none; display: flex; flex-direction: column; gap: 1rem; }
  .side-hubs li { display: grid; grid-template-columns: 3rem 1fr; gap: 0.6rem; align-items: start; }
  .side-hubs .hub-code { color: var(--red-deep); font-weight: 600; padding-top: 0.15rem; }
  .side-hubs strong { display: block; font-size: 0.94rem; font-weight: 600; }
  .side-hubs .data { display: block; margin-top: 0.2rem; }
</style>

<script>
  import { contact } from '../data/company';

  const form = document.getElementById('quote-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const success = document.getElementById('success-msg') as HTMLElement;
  const errorMsg = document.getElementById('form-error') as HTMLElement;

  // Web3Forms access key. Public by design (it lands in the client bundle
  // either way) — abuse is mitigated by the honeypot and the allowed-domains
  // setting in the Web3Forms dashboard. Set PUBLIC_WEB3FORMS_ACCESS_KEY in
  // the Cloudflare Pages build environment; see README.
  const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
  const FALLBACK_EMAIL = contact.quotesEmail;

  let sending = false;

  const fail = (msg: string) => {
    errorMsg.textContent = msg;
    errorMsg.hidden = false;
    sending = false;
    btn.disabled = false;
    btn.innerHTML = 'Send enquiry <span class="arr">→</span>';
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (sending) return;

    // honeypot
    if ((document.getElementById('botcheck') as HTMLInputElement).checked) return;

    sending = true;
    btn.disabled = true;
    btn.textContent = 'Sending…';
    errorMsg.hidden = true;

    // The form has not been connected to an inbox yet — say so plainly
    // rather than silently dropping an enquiry on the floor.
    if (!ACCESS_KEY) {
      fail(
        `This form is not connected to an inbox yet. Please email your enquiry to ${FALLBACK_EMAIL} and it will be picked up.`
      );
      return;
    }

    const fields = new FormData(form);
    fields.append('access_key', ACCESS_KEY);
    fields.append('subject', 'Freight enquiry · Zanzi Logistics website');
    fields.append('from_name', 'Zanzi Logistics Website');

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: fields,
      });
      const data = await res.json().catch(() => ({}) as any);
      if (res.ok && data.success) {
        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      // Surface the real reason the mail service gave.
      fail(
        data.message
          ? `Could not send: ${data.message}. Please try again, or email ${FALLBACK_EMAIL}.`
          : `Something went wrong. Please try again, or email ${FALLBACK_EMAIL}.`
      );
    } catch {
      // fetch threw: usually no connection, or a content blocker / VPN on the
      // device blocked the request to the mail service.
      fail(
        `Could not reach the mail service. Check your connection and any ad blocker or VPN, then try again — or email ${FALLBACK_EMAIL}.`
      );
    }
  });
</script>
