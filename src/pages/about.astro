---
import Base from '../layouts/Base.astro';
import Tab from '../components/Tab.astro';
import { values } from '../data/company';
---
<Base
  title="About · Zanzi Logistics"
  description="We didn’t build Zanzi to move freight. We built it to change what businesses should expect from a logistics partner. Our belief, our values, and what partnership actually looks like."
>

  <header class="page-hero">
    <div class="swoosh" aria-hidden="true"></div>
    <div class="container hero-stack">
      <p class="label">About Zanzi</p>
      <h1 class="display">
        We didn’t build Zanzi<br />to move <em>freight.</em>
      </h1>
      <p class="page-sub">
        We built it to change what businesses should expect from a logistics
        partner. For us, logistics has never been about trucks, routes or
        deliveries. It’s about helping businesses move forward with confidence.
      </p>
    </div>
  </header>

  <!-- ═══ Our Belief ═══ -->
  <section>
    <div class="container">
      <div class="split rv">
        <div>
          <Tab label="Our belief" />
          <h2 class="display">No business<br />succeeds <em>on its own.</em></h2>
        </div>
        <div class="split-body">
          <p>
            The strongest businesses are built by people who know what they’re
            great at &mdash; and by partners who are equally committed to the
            parts they aren’t.
          </p>
          <p>
            We believe logistics should be one of those partnerships. Not
            another supplier to manage, and not another number to call when
            something goes wrong. A trusted extension of your business.
          </p>
          <p>
            Because when the right people take care of logistics, businesses are
            free to focus on everything else.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ More Than Moving Freight ═══ -->
  <section class="dim">
    <div class="container">
      <div class="split rv">
        <div>
          <Tab label="More than moving freight" />
          <h2 class="display">Every shipment carries<br />something <em>bigger.</em></h2>
        </div>
        <div class="split-body">
          <p>
            Every shipment carries something bigger than cargo &mdash; it
            carries commitments, customer expectations, production schedules and
            business reputation.
          </p>
          <p>
            When clients trust us with their logistics, they’re trusting us with
            part of their business. That responsibility shapes every decision we
            make.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ The promise ═══ -->
  <section class="ink-section promise">
    <div class="swoosh" aria-hidden="true"></div>
    <div class="container rv">
      <h2 class="display promise-line">
        We don’t just carry freight.<br /><em>We carry responsibility.</em>
      </h2>
      <div class="promise-body">
        <p>For your deadlines and your customer promises.</p>
        <p>For your reputation and for your peace of mind.</p>
        <p>
          Every shipment is another opportunity to prove that responsibility
          isn’t something we talk about. It’s something we demonstrate. Every
          day.
        </p>
        <p class="promise-close">
          The businesses that trust us aren’t looking for another logistics
          provider. They’re looking for someone who carries the responsibility
          as seriously as they do.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ What Partnership Looks Like ═══ -->
  <section>
    <div class="container">
      <div class="split rv">
        <div>
          <Tab label="What partnership looks like" />
          <h2 class="display">Measured in<br /><em>confidence.</em></h2>
        </div>
        <div class="split-body">
          <p>
            We don’t believe great logistics is measured by kilometres
            travelled. It’s measured by confidence.
          </p>
          <ul class="conf-list">
            <li>The confidence that someone is paying attention.</li>
            <li>The confidence that someone is thinking ahead.</li>
            <li>The confidence that if something changes, you’ll know.</li>
          </ul>
          <p>
            Our clients don’t have to chase updates or manage another supplier.
            They have a team that’s invested in helping their business succeed.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Built Around Relationships ═══ -->
  <section class="dim">
    <div class="container">
      <div class="split rv">
        <div>
          <Tab label="Built around relationships" />
          <h2 class="display">The people you never<br />have to <em>worry about.</em></h2>
        </div>
        <div class="split-body">
          <p>
            The best logistics partnerships aren’t transactional. They’re built
            over time.
          </p>
          <p>
            That’s why we take the time to understand your operation, your
            priorities and the challenges unique to your business.
          </p>
          <p>
            Whether we’re moving a same-day delivery across town or coordinating
            freight across Southern Africa, our goal remains the same: to become
            the people you never have to worry about.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Our Values ═══ -->
  <section id="values">
    <div class="container">
      <div class="sec-head rv">
        <Tab label="Our values" />
        <h2 class="display">What we <em>hold to.</em></h2>
      </div>

      <div class="val-grid rv-group">
        {values.map((v, i) => (
          <div class="val">
            <span class="cap-no">{String(i + 1).padStart(2, '0')}</span>
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="drench">
    <div class="container rv-group">
      <h2 class="display cta-title">
        Let’s build something stronger<br />than a <em>supply chain.</em>
      </h2>
      <p class="cta-sub">
        If you’re looking for a logistics provider, there are plenty to choose
        from. If you’re looking for a partner who treats your business like it’s
        worth protecting, we’d love to talk.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-ink"><span>Start the Conversation</span> <span class="arr">&rarr;</span></a>
        <a href="/services" class="btn btn-ghost-red"><span>Our Capabilities</span></a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── Two-column split ── */
  .split {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .split-body p {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--slate);
  }
  .split-body p + p { margin-top: 1.3rem; }
  @media (max-width: 880px) { .split { grid-template-columns: 1fr; } }

  .conf-list {
    list-style: none;
    margin: 1.4rem 0;
    border-left: 4px solid var(--red);
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .conf-list li {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--slate-strong);
    font-weight: 500;
  }

  /* ── The promise ── */
  .promise { overflow: hidden; }
  .promise-line { font-size: clamp(1.9rem, 4.6vw, 3.6rem); }
  .promise-body { margin-top: clamp(1.8rem, 3.5vw, 2.6rem); max-width: 62ch; }
  .promise-body p { font-size: 1.06rem; line-height: 1.85; color: var(--mist-on-ink); }
  .promise-body p + p { margin-top: 1rem; }
  .promise-close {
    margin-top: 1.6rem !important;
    padding-top: 1.6rem;
    border-top: 1px solid var(--rule-on-ink);
    color: var(--paper-on-ink) !important;
  }

  /* ── Values ── */
  .val-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  .val h3 { margin: 0.9rem 0 0.6rem; }
  .val p { font-size: 0.96rem; line-height: 1.8; color: var(--slate); }
  @media (max-width: 900px) { .val-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .val-grid { grid-template-columns: 1fr; } }

  /* ── CTA ── */
  .cta-title { font-size: clamp(1.9rem, 4.4vw, 3.4rem); }
  .cta-sub { margin-top: 1.4rem; font-size: 1.06rem; line-height: 1.8; max-width: 58ch; }
  .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.2rem; }
</style>
