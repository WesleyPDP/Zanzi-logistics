---
import Base from '../layouts/Base.astro';
import Tab from '../components/Tab.astro';
import { contact, crossings, centres } from '../data/company';
import {
  southAfrica, lesotho, mapDepots, mapCities, mapBorders, mapNeighbours,
  mapRoutes, project, ringToPath, VIEW_W, VIEW_H,
} from '../data/geo';

// The landmass is one path with two rings; fill-rule evenodd punches
// Lesotho out of it.
const landPath = `${ringToPath(southAfrica)} ${ringToPath(lesotho)}`;

// Route legs are given as place codes, so resolve them to projected points.
const allPlaces = [...mapDepots, ...mapCities, ...mapBorders];
const leg = ([from, to]: readonly [string, string]) => {
  const a = allPlaces.find((p) => p.code === from)!;
  const b = allPlaces.find((p) => p.code === to)!;
  const [x1, y1] = project(a.lon, a.lat);
  const [x2, y2] = project(b.lon, b.lat);
  return { x1, y1, x2, y2 };
};
const domesticLegs = mapRoutes.domestic.map(leg);
const borderLegs = mapRoutes.crossBorder.map(leg);
---
<Base
  title="Coverage · Zanzi Logistics"
  description="From our Johannesburg base we move freight across South Africa and throughout the SADC region, with the customs experience to make cross-border movement straightforward."
>

  <header class="page-hero">
    <div class="swoosh" aria-hidden="true"></div>
    <div class="container hero-stack">
      <p class="label">Coverage</p>
      <h1 class="display">Across town, or across<br /><em>Southern Africa.</em></h1>
      <p class="page-sub">
        We operate from Johannesburg, moving freight nationally and across the
        region. Wherever it’s going, the commitment is the same: dependable
        execution, proactive communication and genuine partnership.
      </p>
    </div>
  </header>

  <!-- ═══ The map ═══ -->
  <section class="ink-section map-section">
    <div class="container">
      <div class="sec-head rv">
        <Tab label="Where we move" />
        <h2 class="display">One base.<br />A whole <em>region.</em></h2>
        <p class="sub">
          White runs are domestic linehaul from our Johannesburg base. Red runs
          head for a border. Positions are drawn from real coordinates; the
          routes are simplified to the corridor, not the road.
        </p>
      </div>

      <div class="map-wrap rv">
        <svg
          class="map"
          viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
          role="img"
          aria-labelledby="map-title map-desc"
        >
          <title id="map-title">Map of Zanzi Logistics coverage from Johannesburg</title>
          <desc id="map-desc">
            A map of South Africa. Zanzi Logistics operates from a base in
            Johannesburg, running domestic linehaul to Cape Town, Durban,
            Gqeberha, Bloemfontein and Polokwane, and cross-border routes to
            the Beitbridge crossing for Zimbabwe, Lebombo for Mozambique,
            Skilpadshek for Botswana and Nakop for Namibia. The centres and
            border crossings are also listed in full on this page.
          </desc>

          <!-- landmass, with Lesotho cut out -->
          <path class="m-land" d={landPath} fill-rule="evenodd" />

          <!-- neighbouring countries -->
          <g class="m-neighbour">
            {mapNeighbours.map((n) => {
              const [x, y] = project(n.lon, n.lat);
              return <text x={x} y={y} text-anchor="middle">{n.name}</text>;
            })}
          </g>

          <!-- domestic linehaul -->
          <g class="m-dom">
            {domesticLegs.map((l) => (
              <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} />
            ))}
          </g>

          <!-- cross-border corridors -->
          <g class="m-xb">
            {borderLegs.map((l) => (
              <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} />
            ))}
          </g>

          <!-- border crossings -->
          <g class="m-border">
            {mapBorders.map((b) => {
              const [x, y] = project(b.lon, b.lat);
              return (
                <>
                  <circle cx={x} cy={y} r="5.5" />
                  <text x={x + b.dx} y={y + b.dy} text-anchor={b.anchor}>{b.name}</text>
                </>
              );
            })}
          </g>

          <!-- centres served -->
          <g class="m-city">
            {mapCities.map((c) => {
              const [x, y] = project(c.lon, c.lat);
              return (
                <>
                  <rect x={x - 4} y={y - 4} width="8" height="8" />
                  <text x={x + c.dx} y={y + c.dy} text-anchor={c.anchor}>{c.name}</text>
                </>
              );
            })}
          </g>

          <!-- the base -->
          <g class="m-depot">
            {mapDepots.map((d) => {
              const [x, y] = project(d.lon, d.lat);
              return (
                <>
                  <rect x={x - 7} y={y - 7} width="14" height="14" />
                  <text x={x + d.dx} y={y + d.dy} text-anchor={d.anchor}>{d.name}</text>
                  <text
                    class="m-depot-sub"
                    x={x + d.dx}
                    y={y + d.dy + 15}
                    text-anchor={d.anchor}
                  >Our base</text>
                </>
              );
            })}
          </g>

          <!-- key -->
          <g class="m-key">
            <line class="m-key-dom" x1="30" y1="34" x2="66" y2="34" />
            <text x="76" y="38">Domestic linehaul</text>
            <line class="m-key-xb" x1="30" y1="60" x2="66" y2="60" />
            <text x="76" y="64">Cross-border</text>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- ═══ National ═══ -->
  <section>
    <div class="container">
      <div class="split rv">
        <div>
          <Tab label="Nationally" />
          <h2 class="display">Keeping your operations <em>connected.</em></h2>
          <p class="split-lead">
            Reliable transport between branches, warehouses and distribution
            centres, into every major centre in the country &mdash; and to the
            addresses in between.
          </p>
        </div>
        <div>
          <ul class="centre-list">
            {centres.map((c) => <li>{c}</li>)}
          </ul>
          <p class="centre-note">
            Delivering somewhere not on this list? That’s usually a yes &mdash;
            <a class="link" href="/contact">tell us where it needs to go</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Cross-border ═══ -->
  <section class="dim">
    <div class="container">
      <div class="sec-head rv">
        <Tab label="Cross-border" />
        <h2 class="display">Southern Africa without<br />the <em>uncertainty.</em></h2>
        <p class="sub">
          Moving freight across borders is about more than transport. It’s about
          documentation, compliance, coordination and experience. We manage the
          complexity behind the scenes so your business can continue moving
          forward.
        </p>
      </div>

      <div class="cross-grid rv-group">
        {crossings.map((c) => (
          <div class="cross">
            <span class="cross-country">{c.country}</span>
            <span class="label cross-post">via {c.post}</span>
          </div>
        ))}
      </div>

      <p class="cross-note rv">
        Transit depends entirely on the consignment and the paperwork, so we
        quote it per shipment rather than publishing a number we can’t stand
        behind. Ask us and you’ll get a straight answer for your freight.
      </p>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="drench">
    <div class="container rv-group">
      <h2 class="display cta-title">Tell us where it<br />needs to <em>go.</em></h2>
      <p class="cta-sub">
        Whether it’s across town or across a border, we’d like to understand
        your operation before we quote it.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-ink"><span>Start the Conversation</span> <span class="arr">&rarr;</span></a>
        <a href={contact.phoneHref} class="btn btn-ghost-red"><span>Call {contact.phone}</span></a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── The map ── */
  .map-section { overflow: hidden; }
  .map-wrap { max-width: 880px; margin: 0 auto; }
  .map { width: 100%; height: auto; }

  .m-land {
    fill: var(--ink-line);
    stroke: var(--rule-on-ink-strong);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .m-neighbour text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    fill: var(--mist-on-ink);
    opacity: 0.5;
  }

  /* Both route types are dashed; colour and dash length tell them apart.
     No stroke-dashoffset reveal here — these styles are scoped, so a
     selector rooted at `html.js` would be rewritten to `.js[data-astro-cid]`
     and never match, leaving the routes permanently hidden. The whole
     figure already fades in via .rv on .map-wrap. */
  .m-dom line {
    stroke: var(--paper-on-ink);
    stroke-width: 2.5;
    stroke-dasharray: 12 7;
    stroke-linecap: butt;
  }
  .m-xb line {
    stroke: var(--red-bright);
    stroke-width: 2.5;
    stroke-dasharray: 6 5;
    stroke-linecap: butt;
  }

  /* Cartographic halo: the stroke is painted before the fill, so every
     label knocks a dark gap out of any route line running behind it. */
  .m-border text, .m-city text, .m-depot text {
    paint-order: stroke;
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linejoin: round;
  }

  .m-border circle { fill: var(--red-bright); }
  .m-border text {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--red-bright);
  }

  .m-city rect { fill: var(--mist-on-ink); }
  .m-city text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    fill: var(--mist-on-ink);
  }

  .m-depot rect { fill: var(--red); }
  .m-depot text {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    fill: var(--paper-on-ink);
  }
  .m-depot .m-depot-sub {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--red-bright);
  }

  .m-key text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--mist-on-ink);
  }
  .m-key-dom { stroke: var(--paper-on-ink); stroke-width: 2.5; stroke-dasharray: 12 7; }
  .m-key-xb { stroke: var(--red-bright); stroke-width: 2.5; stroke-dasharray: 6 5; }

  /* ── National ── */
  .split {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .split-lead {
    margin-top: 1.4rem;
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--slate);
  }
  @media (max-width: 880px) { .split { grid-template-columns: 1fr; } }

  /* box-shadow rings rather than a container background, so an odd item
     count never leaves an empty grey cell in the last row */
  .centre-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
  }
  .centre-list li {
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--rule);
    padding: 0.95rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .centre-note {
    margin-top: 1.3rem;
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--slate);
  }
  @media (max-width: 440px) { .centre-list { grid-template-columns: 1fr; } }

  /* ── Cross-border ── */
  .cross-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
  }
  .cross {
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--rule);
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-left: 3px solid var(--red);
  }
  .cross-country {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .cross-post { letter-spacing: 0.1em; }
  .cross-note {
    margin-top: clamp(1.6rem, 3vw, 2.2rem);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--slate);
    max-width: 64ch;
  }
  @media (max-width: 900px) { .cross-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .cross-grid { grid-template-columns: 1fr; } }

  /* ── CTA ── */
  .cta-title { font-size: clamp(1.9rem, 4.4vw, 3.4rem); }
  .cta-sub { margin-top: 1.4rem; font-size: 1.06rem; line-height: 1.8; max-width: 52ch; }
  .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.2rem; }
</style>
