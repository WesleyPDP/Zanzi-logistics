---
import '@fontsource-variable/oswald/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import { company, contact, capabilities } from '../data/company';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Zanzi Logistics takes responsibility for the operational challenges between your business and its growth. Linehaul, same-day express, cross-border, dedicated freight, project logistics, healthcare logistics and warehousing across Southern Africa.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const year = new Date().getFullYear();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  slogan: company.promise,
  description: company.intro,
  url: Astro.site?.toString(),
  logo: new URL('/logo/zanzi-logistics.png', Astro.site).toString(),
  telephone: contact.phone,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Johannesburg',
    addressCountry: 'ZA',
  },
  areaServed: [
    { '@type': 'Country', name: 'South Africa' },
    { '@type': 'Place', name: 'SADC region' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Logistics capabilities',
    itemListElement: capabilities.map((c) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: c.name, description: c.short },
    })),
  },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#e00014" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={company.name} />
  <meta property="og:image" content={new URL('/logo/zanzi-logistics.png', Astro.site)} />
  <meta name="twitter:card" content="summary" />
  <link rel="canonical" href={canonicalURL} />
  <!-- ?v= busts the aggressive favicon cache when the mark changes -->
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <title>{title}</title>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>

  <a class="skip-link" href="#main">Skip to content</a>

  <nav class="site-nav" id="site-nav" aria-label="Main">
    <div class="nav-inner">
      <a href="/" class="brand" aria-label={`${company.name}, home`}>
        <img src="/logo/zanzi-logistics.svg" alt={company.name} width="186" height="125" />
      </a>

      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
      </button>

      <div class="nav-links">
        <a href="/services" class={isActive('/services') ? 'active' : ''}>Capabilities</a>
        <a href="/network" class={isActive('/network') ? 'active' : ''}>Coverage</a>
        <a href="/about" class={isActive('/about') ? 'active' : ''}>About</a>
        <a href="/contact" class={`nav-cta ${isActive('/contact') ? 'active' : ''}`}><span>Let’s Talk</span></a>
      </div>
    </div>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer>
    <div class="footer-rule"></div>
    <div class="footer-inner">
      <div class="footer-top">
        <div class="footer-brand">
          <img src="/logo/zanzi-logistics-on-dark.svg" alt={company.name} width="186" height="125" />
          <p>{company.promise}</p>
        </div>

        <div class="footer-col">
          <h4>Capabilities</h4>
          <ul>
            {capabilities.map((c) => (
              <li><a href={`/services#${c.slug}`}>{c.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-col">
          <h4>Get in touch</h4>
          <ul>
            <li><a href={contact.phoneHref} class="fc-strong">{contact.phone}</a></li>
            <li><a href={contact.phoneAltHref} class="fc-strong">{contact.phoneAlt}</a></li>
            <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li>{contact.office}</li>
            <li>{contact.hours}</li>
          </ul>
        </div>
      </div>

      <div class="footer-legal">
        <span class="label">&copy; {year} {company.legalName}</span>
        <span class="label">ISO 9001 &middot; ISO 13485 &middot; ISO 45001</span>
      </div>
    </div>
  </footer>

  <script>
    // Mobile nav
    const nav = document.getElementById('site-nav')!;
    const toggle = document.getElementById('nav-toggle')!;
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('nav-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    nav.querySelectorAll('.nav-links a').forEach((a) =>
      a.addEventListener('click', () => {
        nav.classList.remove('nav-open');
        toggle.setAttribute('aria-expanded', 'false');
      })
    );

    // Scroll reveals (.rv single elements, .rv-group staggered children).
    // Hidden states only apply under html.js, so no-JS visitors see
    // everything; anything already in the viewport reveals synchronously
    // to avoid a flash when the class lands.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('.rv, .rv-group');
    if (!reduced) document.documentElement.classList.add('js');
    if (reduced) {
      targets.forEach((el) => el.classList.add('in'));
    } else {
      const vh = window.innerHeight;
      const below: Element[] = [];
      targets.forEach((el) => {
        if (el.getBoundingClientRect().top < vh) el.classList.add('in');
        else below.push(el);
      });
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
      );
      below.forEach((el) => io.observe(el));
    }
  </script>
</body>
</html>
